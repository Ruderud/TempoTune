{
  "name": "@tempo-tune/web",
  "version": "0.1.63",
  "private": true,
  "scripts": {
    "dev": "bash scripts/start-dev.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "version:update": "node scripts/update-web-version.js",
    "version:inject": "node scripts/inject-version.js",
    "build:cf": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "preview": "opennextjs-cloudflare build && wrangler dev"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.74.0",
    "@tempo-tune/audio-input": "workspace:*",
    "lucide-react": "^0.577.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.124.0"
  }
}
