{
  "name": "@tempo-tune/mobile",
  "version": "1.0.9",
  "private": true,
  "scripts": {
    "prestart": "bash scripts/generate-dev-config.sh",
    "start": "bash scripts/start-metro.sh",
    "android": "bash scripts/generate-dev-config.sh && react-native run-android",
    "ios": "bash scripts/generate-dev-config.sh && react-native run-ios",
    "ios:device": "bash scripts/generate-dev-config.sh && react-native run-ios --device",
    "ios:device:udid": "bash scripts/generate-dev-config.sh && react-native run-ios --device --udid",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "version:update": "node scripts/update-app-version.js",
    "version:inject": "node scripts/inject-version.js"
  },
  "dependencies": {
    "react": "19.1.9",
    "react-native": "0.81.6",
    "react-native-webview": "^13.12.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/babel-preset": "^0.81.6",
    "@react-native/eslint-config": "^0.81.6",
    "@react-native/metro-config": "^0.81.6",
    "@react-native/typescript-config": "^0.81.6",
    "@types/react": "19.2.18",
    "@wdio/appium-service": "^9.30.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "appium": "^2.12.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "webdriverio": "^9.30.1"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
