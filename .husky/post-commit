# Remind maintainers about TestFlight when iOS native changes were committed.
# Uploads stay manual so signing and release actions require explicit approval.
COMMITTED_FILES=$(git diff-tree --no-commit-id --name-only -r HEAD)
IOS_NATIVE=$(echo "$COMMITTED_FILES" | grep -E '^apps/mobile/ios/.*\.(swift|m|h|plist|entitlements)$' || true)

if [ -n "$IOS_NATIVE" ]; then
  echo "[post-commit] iOS native changes detected."
  echo "[post-commit] After explicit release approval, run: ./scripts/ios-testflight.sh"
fi
